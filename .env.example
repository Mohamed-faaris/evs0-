# Optional serial device path for the MQTT provisioning script\n# Example: /dev/ttyUSB0\nESP32_PORT=\n\n# Existing CuspNode mock server
HOST=127.0.0.1
PORT=3001

# Hono API
API_HOST=0.0.0.0
API_PORT=3002

# MQTT broker settings from firmware/mqtt.md
MQTT_HOST=evs.mqtt.cusptech.dev
# Use mqtts for MQTT over TLS or wss for MQTT over secure WebSockets.
MQTT_PROTOCOL=mqtts
# Set the exact port configured on the broker. Leave blank only if the broker uses the protocol default.
MQTT_PORT=
# Required only for WSS when the broker specifies a custom WebSocket path.
MQTT_PATH=
# Optional full URL override. If set, it takes precedence over MQTT_PROTOCOL/HOST/PORT/PATH.
# Examples: mqtts://evs.mqtt.cusptech.dev:<TLS_PORT> or wss://evs.mqtt.cusptech.dev:<WSS_PORT>/<WS_PATH>
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=evs0-dashboard-api
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_KEEPALIVE_SECONDS=60
MQTT_CLEAN_SESSION=true

# Mock-device MQTT client (uses the same broker settings above).
MQTT_MOCK_CLIENT_ID=cuspnode-mock-device-001
MQTT_PUBLISH_INTERVAL_MS=5000
# Optional CA bundle path (relative to repository root or absolute).
# Leave blank to use the Node.js system trust store.
MQTT_CA_PATH=

# Dashboard MQTT topic root — matches firmware/mqtt.md
MQTT_TOPIC_ROOT=evs/v1/devices
