# Optional serial device path for the MQTT provisioning script\n# Example: /dev/ttyUSB0\nESP32_PORT=\n\n# Existing CuspNode mock server
HOST=127.0.0.1
PORT=3001

# Hono API
API_HOST=0.0.0.0
API_PORT=3002

# MQTT broker settings from firmware/mqtt.md
MQTT_HOST=c1a1d217.ala.us-east-1.emqxsl.com
# Use mqtts for MQTT over TLS or wss for MQTT over secure WebSockets.
MQTT_PROTOCOL=mqtts
# Set the exact port configured on the broker. Leave blank only if the broker uses the protocol default.
MQTT_PORT=8883
# Required only for WSS when the broker specifies a custom WebSocket path.
MQTT_PATH=
# Optional full URL override. If set, it takes precedence over MQTT_PROTOCOL/HOST/PORT/PATH.
# Examples: mqtts://evs.mqtt.cusptech.dev:<TLS_PORT> or wss://evs.mqtt.cusptech.dev:<WSS_PORT>/<WS_PATH>
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=evs0-dashboard-api
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_KEEPALIVE_SECONDS=60
MQTT_CLEAN_SESSION=true

# Mock-device MQTT client (uses the same broker settings above).
MQTT_MOCK_CLIENT_ID=cuspnode-mock-device-001
MQTT_PUBLISH_INTERVAL_MS=5000
# Optional CA bundle path (relative to repository root or absolute).
# Leave blank to use the Node.js system trust store.
MQTT_CA_PATH=

# Dashboard MQTT topic root — matches firmware/mqtt.md
MQTT_TOPIC_ROOT=evs/v1/devices

# Simulated power-meter MQTT publisher
POWER_METER_DEVICE_ID=power-meter-001
MQTT_POWER_METER_CLIENT_ID=cuspnode-mock-power-meter-001
MQTT_POWER_METER_PUBLISH_INTERVAL_MS=5000
# Hide current-session meter estimates when the meter is offline or the latest sample is older than this.
POWER_METER_MAX_AGE_SECONDS=20

# India grid emission factor used for location-based electricity CO2 estimates (CEA v22.0, FY2025-26).
# Unit: kg CO2 per kWh. Change only when adopting a different documented grid factor.
GRID_EMISSION_FACTOR_KG_CO2_PER_KWH=0.675
# Leave provenance blank to use CEA details for the default 0.675 factor.
# For a custom factor, provide the source, fiscal period, and calculation scope.
GRID_EMISSION_FACTOR_SOURCE=
GRID_EMISSION_FACTOR_FISCAL_YEAR=
GRID_EMISSION_FACTOR_SCOPE=

# Lightweight forecast model settings (not trained AI models).
# Exponential smoothing alpha must be greater than 0 and <= 1.
SENSOR_FORECAST_ALPHA=0.25
ENERGY_FORECAST_ALPHA=0.25
# API requires this many valid samples and uses at most this many latest samples.
FORECAST_MIN_SAMPLES=10
FORECAST_WINDOW_SAMPLES=120

# Vite dashboard device IDs (must match MQTT publishers)
VITE_POWER_METER_DEVICE_ID=power-meter-001

# Read-only proxy target used by the Power Map dashboard tab (Reclaim Chennai)
POWER_MAP_UPSTREAM=https://power.reclaimchennai.city

# Optional, only after confirming the actual AQI station JSON route with the source owner.
# Must be an HTTPS /api/ endpoint on pol.reclaimchennai.city or api.airquality.info.
# Leave blank until a real public station endpoint is confirmed. The default is intentionally disabled.
CHENNAI_AQI_STATIONS_URL=
